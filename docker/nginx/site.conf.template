# ${SERVER_NAME} est renseigné au démarrage du conteneur. Le certificat vient de
# Let's Encrypt s'il existe, sinon un certificat local est créé (certificate.sh).
server_tokens off;

# Vidéos du Lookbook : un peu au-dessus du post_max_size de PHP (70 Mo).
client_max_body_size 72m;

gzip on;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_types text/plain text/css text/xml application/json application/javascript application/xml application/rss+xml image/svg+xml font/ttf;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# Un autre nom de domaine pointant vers ce serveur n'obtient rien : Laravel
# construit ses adresses (sitemap, liens) à partir du domaine demandé.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    # Vérification de Let's Encrypt lors de la demande de certificat.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate /run/site-cert/fullchain.pem;
    ssl_certificate_key /run/site-cert/privkey.pem;

    root /var/www/html/public;
    index index.php;

    # Nginx oublie les en-têtes du niveau supérieur dès qu'un bloc location a
    # son propre add_header : chacun de ces blocs doit inclure ce fichier.
    include /etc/nginx/snippets/security-headers.conf;

    # Fichiers de build : leur nom change à chaque version.
    location ^~ /build/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Photos et vidéos envoyées : jamais de PHP exécuté ici.
    location ^~ /storage/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    # Logo, polices et scripts du back-office. Sans fichier, Laravel répond
    # (/livewire/livewire.js est une route).
    location ~* \.(?:css|js|png|jpg|jpeg|webp|svg|ico|woff2?)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        # Résolu à chaque requête : le conteneur app change d'adresse quand il redémarre.
        resolver 127.0.0.11 valid=10s;
        set $php_upstream app:9000;
        fastcgi_pass $php_upstream;

        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_param HTTP_PROXY "";
        fastcgi_read_timeout 120s;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
    }

    # Tout autre script PHP, et les fichiers cachés (.env…), n'existent pas.
    location ~ \.php$ {
        return 404;
    }

    location ~ /\. {
        return 404;
    }
}
