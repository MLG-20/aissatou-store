# Le certificat HTTPS est obtenu et renouvelé par Caddy.
{$SITE_ADDRESS} {
	root * /var/www/html/public
	encode zstd gzip

	# Fichiers de build : leur nom change à chaque version.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_fastcgi app:9000
	file_server
}
