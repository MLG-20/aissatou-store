# Copier vers .env.docker (jamais commité) et remplir.
# Générer APP_KEY : echo "base64:$(openssl rand -base64 32)"

# --- Essai sur l'ordinateur ---
# En production : SITE_ADDRESS=mondomaine.sn, ports 80 et 443, APP_URL=https://mondomaine.sn
SITE_ADDRESS=https://localhost:443
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
APP_URL=https://localhost:8443

APP_NAME="Aissatou Store"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aissatou
DB_USERNAME=aissatou
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Premier compte admin, créé une seule fois avec AdminSeeder.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# En production : les vrais réglages d'envoi d'e-mails.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=contact@example.com
MAIL_FROM_NAME="${APP_NAME}"

PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
PAYTECH_IPN_URL=

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
